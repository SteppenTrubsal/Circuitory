cabal-version:      3.0
name:               server
version:            0.0.0.0
-- synopsis:
-- description:
license:            NONE
author:             Niko
maintainer:         n1kokara@yandex.ru
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MyLib
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.18.3.0
    hs-source-dirs:   core
    default-language: Haskell2010

library conf
    import:             warnings
    exposed-modules:    Config
    other-modules:
                Config.Common
    build-depends:
                base ^>=4.18.3.0,
                aeson,
                lens,
                yaml
    hs-source-dirs:     conf
    default-language:   Haskell2010
    default-extensions: TemplateHaskell, 
                        OverloadedStrings

executable server
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.3.0,
        server,
        conf

    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:
                base ^>=4.18.3.0,
                lens

test-suite server-test
    import:           warnings
    default-language: Haskell2010
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        server
